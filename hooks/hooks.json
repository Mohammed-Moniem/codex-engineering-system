{
  "description": "Optional Wayfinder recovery and destructive-Git guardrails.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/session_start.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\hooks\\session_start.py\"",
            "timeout": 3,
            "additionalContextLimit": 256,
            "statusMessage": "Checking for an active Wayfinder map"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/pre_tool_use.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\hooks\\pre_tool_use.py\"",
            "timeout": 3,
            "statusMessage": "Checking Git command safety"
          }
        ]
      }
    ]
  }
}
